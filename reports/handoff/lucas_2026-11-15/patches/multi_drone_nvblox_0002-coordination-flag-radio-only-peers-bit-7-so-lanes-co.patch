From 3647995e54df90d20fb1491a826bc06366a5fe8c Mon Sep 17 00:00:00 2001
From: ssaigarimella <sgarimella34@gatech.edu>
Date: Mon, 26 Oct 2026 18:32:10 -0400
Subject: [PATCH 2/2] coordination: flag radio-only peers (bit 7) so lanes
 count live stacks only

A radio keeps beaconing the last pose it was fed after its vehicle's stack
stops (2026-10-23: thunderstrike listed delta at age 0.1 s with delta's
stack down). Claim packets go out every coordination cycle whenever a stack
is up, so a peer whose claim channel is silent for peer_timeout_s but whose
radio is heard is radio-only: coordination_node sets FLAG_RADIO_ONLY (bit 7,
receiver-side, never on the wire) in SwarmPeers; the planner keeps such a
peer for keep-out and leaves it out of lane assignment. New unit test; all
122 tests pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mdn_core/coordination_logic.py  | 16 ++++++++++++++++
 scripts/coordination_node.py    |  5 +++--
 test/test_coordination_logic.py | 14 ++++++++++++++
 3 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/mdn_core/coordination_logic.py b/mdn_core/coordination_logic.py
index fc466b2..f9053f0 100644
--- a/mdn_core/coordination_logic.py
+++ b/mdn_core/coordination_logic.py
@@ -35,6 +35,13 @@ FLAG_WIFI_UP = 1 << 0
 FLAG_MAP_OK = 1 << 1
 FLAG_ALIGNMENT_OK = 1 << 2
 FLAG_LOW_BATT = 1 << 3
+# Set by the RECEIVER on SwarmPeers (never on the wire): the peer's radio is
+# heard but its coordination stack is not (no claim packet within
+# peer_timeout_s). A radio keeps beaconing the last pose it was fed after its
+# vehicle's stack stops (2026-10-23: thunderstrike listed delta at age 0.1 s
+# while delta's stack was down), so such a peer is a parked obstacle, not a
+# team member: keep out of its position, but leave it out of lane assignment.
+FLAG_RADIO_ONLY = 1 << 7
 
 
 def _hypot2(ax, ay, bx, by):
@@ -137,6 +144,15 @@ class PeerTable(object):
     def live_peers(self, now_s=None):
         return sorted(self.entries.keys())
 
+    def radio_only(self, peer_id, now_s):
+        """True if the peer's radio is heard but its stack is not: no claim
+        packet within peer_timeout_s (one is sent every coordination cycle
+        whenever the stack is up, claim or not). See FLAG_RADIO_ONLY."""
+        e = self.entries.get(peer_id)
+        return (e is not None and
+                (e.last_claim_rx_s is None or
+                 now_s - e.last_claim_rx_s > self.peer_timeout_s))
+
     def n_live(self):
         """Live vehicle count INCLUDING self (lane assignment input)."""
         return len(self.entries) + 1
diff --git a/scripts/coordination_node.py b/scripts/coordination_node.py
index 8cf5b95..9af3790 100755
--- a/scripts/coordination_node.py
+++ b/scripts/coordination_node.py
@@ -53,7 +53,7 @@ from mdn_core.fault_logic import (
 from mdn_core.coordination_logic import (
     PeerTable, ClaimLifecycle, CLAIM_NONE,
     FLAG_WIFI_UP, FLAG_MAP_OK, FLAG_ALIGNMENT_OK, FLAG_LOW_BATT,
-    MODE_FRONTIER)
+    FLAG_RADIO_ONLY, MODE_FRONTIER)
 
 try:
     from radiohive.msg import LoraPose, LoraSend, PeerPose, PeerMessage
@@ -394,7 +394,8 @@ class CoordinationNode(Node):
             ps.claim_gain = int(e.claim_gain)
             ps.lane_id = e.lane_id
             ps.mode = e.mode
-            ps.flags = e.flags
+            ps.flags = e.flags | (FLAG_RADIO_ONLY
+                                  if self.table.radio_only(pid, now) else 0)
             ps.batt = e.batt
             ps.age_s = float(now - e.last_rx_s) if e.last_rx_s else -1.0
             ps.delivery_ratio = float(e.delivery_ratio())
diff --git a/test/test_coordination_logic.py b/test/test_coordination_logic.py
index bd6cf9c..47c9011 100644
--- a/test/test_coordination_logic.py
+++ b/test/test_coordination_logic.py
@@ -22,6 +22,20 @@ def mk_claim(src_id, seq, cx=0.0, cy=0.0, state=CLAIM_SEEKING, gain=100):
 
 
 class TestPeerTable(unittest.TestCase):
+    def test_radio_only_peer(self):
+        # a radio keeps beaconing its last pose after the vehicle's stack
+        # stops: pose traffic alone must read as radio-only (2026-10-23)
+        pt = PeerTable(self_id=2, peer_timeout_s=3.0)
+        pt.update_pose(0, 1.0, 2.0, 0.0, 0.0, now_s=10.0)
+        self.assertTrue(pt.radio_only(0, 10.0))          # never sent a claim
+        pt.update_claim(mk_claim(0, 0), now_s=11.0)
+        self.assertFalse(pt.radio_only(0, 14.0))         # boundary inclusive
+        pt.update_pose(0, 1.0, 2.0, 0.0, 0.0, now_s=14.5)
+        self.assertTrue(pt.radio_only(0, 14.5))          # claims stopped
+        self.assertEqual(pt.expire(14.5), [])            # still a live obstacle
+        self.assertEqual([p[0] for p in pt.peer_positions()], [0])
+        self.assertFalse(pt.radio_only(9, 14.5))         # unknown peer
+
     def test_fresh_pose_does_not_renew_old_claim(self):
         pt = PeerTable(self_id=2, peer_timeout_s=3.0)
         pt.update_claim(mk_claim(1, 0, cx=5.0), now_s=0.0)
