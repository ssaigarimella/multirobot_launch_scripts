+def _pc2_xyi(msg: PointCloud2):
+    """(x, y, intensity) float32 arrays from a PointCloud2 with xyz + intensity.
+
+    Vectorized. The per-point struct.unpack loop this replaces starved the
+    planner's single thread outdoors: on 2026-10-23 the ESDF slice reached
+    4.3 MB per message at ~2 Hz and the 20 Hz control loop (setpoints,
+    waypoint-reached, path-blocked) ran at 2.3-4.6 Hz on every flight.
+    Non-finite points are dropped, exactly as before.
+    """
+    offs = {f.name: f.offset for f in msg.fields}
+    empty = np.zeros(0, dtype=np.float32)
+    if (msg.point_step == 0 or
+            not all(k in offs for k in ("x", "y", "intensity"))):
+        return empty, empty, empty
+    n = len(msg.data) // msg.point_step
+    rec = np.dtype({"names": ["x", "y", "i"],
+                    "formats": ["<f4", "<f4", "<f4"],
+                    "offsets": [offs["x"], offs["y"], offs["intensity"]],
+                    "itemsize": msg.point_step})
+    pts = np.frombuffer(msg.data, dtype=rec, count=n)
+    x, y, i = pts["x"], pts["y"], pts["i"]
+    ok = np.isfinite(x) & np.isfinite(y) & np.isfinite(i)
+    return x[ok], y[ok], i[ok]
 
 
