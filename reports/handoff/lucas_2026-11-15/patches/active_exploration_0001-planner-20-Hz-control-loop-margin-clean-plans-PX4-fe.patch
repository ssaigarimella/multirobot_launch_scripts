+    def _planning_grid(self):
+        """self.grid with every cell outside the geofence margin blocked.
+
+        A* used to plan on the raw grid and only the 20 Hz loop applied the
+        margin, so a path along the fence, or A*'s 1 m goal snap, ended
+        outside it: delta 2026-10-23 picked viewpoint (3.3, 13.5) inside the
+        margin, the blocked goal snapped to (2.3, 14.4) beyond y_max - 0.3,
+        and the loop rejected it and re-planned the same plan for 23 s.
+        Blocking the band makes every plan margin-clean by construction; a
+        drone standing in the band (takeoff on the x = 0 line) is handled by
+        A*'s start snap, exactly like a start next to a wall."""
+        mask = getattr(self, "_outside_margin", None)
+        if mask is None or mask.shape != self.grid.shape:
+            nx, ny = self.grid.shape
+            xs = self.bbox_min_x + (np.arange(nx) + 0.5) * self.voxel_size
+            ys = self.bbox_min_y + (np.arange(ny) + 0.5) * self.voxel_size
+            m = self.geofence_margin
+            inx = (xs > self.bbox_min_x + m) & (xs < self.bbox_max_x - m)
+            iny = (ys > self.bbox_min_y + m) & (ys < self.bbox_max_y - m)
+            mask = ~(inx[:, None] & iny[None, :])
+            self._outside_margin = mask
+        g = self.grid.copy()
+        g[mask] = 0.0
+        return g
+
